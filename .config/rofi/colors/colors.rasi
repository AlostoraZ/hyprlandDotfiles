* {
    /* Background shades */
    bg0: #13140d;
    bg1: #1c1c14;
    bg2: #202018;
    bg3: #2a2a22;

    /* Foreground shades */
    fg0: #e5e3d6;
    //fg0: #a2d0c1;
    fg1: #2e3300;
    fg2: #c8c7b7;
    fg3: #47483b;

    /* Material theme mapping (optional for Waybar modules) */
    primary: #c5cd7a;
    secondary: #c7c9a6;
    tertiary: #a2d0c1;
    error: #ffb4ab;
    outline: #929282;
}
